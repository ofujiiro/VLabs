# Store and check out text with Unix line endings on every system, so the
# formatter and the tests behave the same on Windows and on Linux.
* text=auto eol=lf

# Sounds, images and fonts are never text.
*.sf2 binary
*.wav binary
*.flac binary
*.ogg binary
*.mp3 binary
*.mid binary
*.png binary
*.ico binary
*.ttf binary
*.otf binary
